              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rates?from=2024-05-01&to=2024-05-31&base=EUR&quotes=USD",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rates"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "2024-05-01"
                },
                {
                  "key": "to",
                  "value": "2024-05-31"
                },
                {
                  "key": "base",
                  "value": "EUR"
                },
                {
                  "key": "quotes",
                  "value": "USD"
                }
              ]
            },
            "description": "Requisição indicada no briefing. Fonte misturada: inclui sábados e domingos."
          }
        },
        {
          "name": "05 Histórico maio/2024 (BCE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Nenhum sábado ou domingo\", () => {",
                  "  pm.response.json().forEach((r) => {",
                  "    const day = new Date(r.date + \"T00:00:00Z\").getUTCDay();",
                  "    pm.expect(day, r.date).to.be.within(1, 5);",
                  "  });",
                  "});",
                  "pm.test(\"Começa em 30/04 (feriado em 01/05)\", () => pm.expect(pm.response.json()[0].date).to.eql(\"2024-04-30\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rates?from=2024-05-01&to=2024-05-31&base=EUR&quotes=USD&providers=ECB",
