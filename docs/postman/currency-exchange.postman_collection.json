                  "  const dates = pm.response.json().map((r) => r.date);",
                  "  pm.expect(dates).to.eql([...dates].sort());",
                  "});",
                  "pm.test(\"Inclui fim de semana (04/05/2024 é sábado)\", () => {",
                  "  const dates = pm.response.json().map((r) => r.date);",
                  "  pm.expect(dates).to.include(\"2024-05-04\");",
                  "});"
