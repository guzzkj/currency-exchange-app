{
  "info": {
    "name": "Currency Exchange App — Frankfurter v2",
    "description": "Investigação da API Frankfurter v2 para o Lastro (cartão 7). Detalhes em docs/API_TESTS.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Moedas",
      "item": [
        {
          "name": "01 Moedas disponíveis",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Array de moedas com iso_code e name\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.be.an(\"array\").that.is.not.empty;",
                  "  pm.expect(body[0]).to.include.keys(\"iso_code\", \"name\", \"start_date\", \"end_date\");",
                  "});",
                  "pm.test(\"Contém as 10 moedas do app\", () => {",
                  "  const codes = pm.response.json().map((c) => c.iso_code);",
                  "  [\"AUD\",\"BRL\",\"CAD\",\"CHF\",\"CNY\",\"EUR\",\"GBP\",\"JPY\",\"MXN\",\"USD\"].forEach((c) => pm.expect(codes).to.include(c));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/currencies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "currencies"
              ]
            },
            "description": "Lista de moedas. Usada para montar o seletor."
          }
        }
      ]
    },
    {
      "name": "2. Cotação mais recente",
      "item": [
        {
          "name": "02 Cotação EUR → USD",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Formato { date, base, quote, rate }\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.keys(\"date\", \"base\", \"quote\", \"rate\");",
                  "  pm.expect(body.rate).to.be.a(\"number\").and.above(0);",
                  "  pm.expect(body.date).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);",
                  "});",
                  "pm.test(\"Par correto\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.base).to.eql(\"EUR\");",
                  "  pm.expect(body.quote).to.eql(\"USD\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rate/EUR/USD",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rate",
                "EUR",
                "USD"
              ]
            },
            "description": "Requisição indicada no briefing."
          }
        },
        {
          "name": "03 Cotação EUR → BRL (padrão do app)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Formato { date, base, quote, rate }\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.keys(\"date\", \"base\", \"quote\", \"rate\");",
                  "  pm.expect(body.rate).to.be.a(\"number\").and.above(0);",
                  "  pm.expect(body.date).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);",
                  "});",
                  "pm.test(\"Data efetiva não cai em fim de semana\", () => {",
                  "  const day = new Date(pm.response.json().date + \"T00:00:00Z\").getUTCDay();",
                  "  pm.expect(day).to.be.within(1, 5);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rate/EUR/BRL?providers=ECB",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rate",
                "EUR",
                "BRL"
              ],
              "query": [
                {
                  "key": "providers",
                  "value": "ECB"
                }
              ]
            },
            "description": "Par padrão (RN05) com a fonte escolhida para o app (BCE)."
          }
        },
        {
          "name": "08 Várias moedas numa chamada",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Um item por moeda pedida\", () => {",
                  "  const quotes = pm.response.json().map((r) => r.quote).sort();",
                  "  pm.expect(quotes).to.eql([\"BRL\", \"USD\"]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rates?base=EUR&quotes=USD,BRL",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rates"
              ],
              "query": [
                {
                  "key": "base",
                  "value": "EUR"
                },
                {
                  "key": "quotes",
                  "value": "USD,BRL"
                }
              ]
            },
            "description": "Sem from/to: só a cotação mais recente de cada moeda."
          }
        },
        {
          "name": "15 Mesma moeda",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"rate = 1\", () => pm.expect(pm.response.json().rate).to.eql(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rate/EUR/EUR",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rate",
                "EUR",
                "EUR"
              ]
            },
            "description": "A API aceita, mas o app não deixa escolher o mesmo par (RN03)."
          }
        }
      ]
    },
    {
      "name": "3. Histórico",
